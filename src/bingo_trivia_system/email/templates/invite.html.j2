<!doctype html>
<html>
<body style="font-family: Arial, sans-serif; max-width: 600px; margin: auto;">
  <h2>{{ event.title }}</h2>
  <p>Hi{% if display_name %} {{ display_name }}{% endif %},</p>
  <p>You're invited to play! Your unique bingo card is attached as a PDF.</p>
  <ul>
    <li><strong>Print it</strong> and stamp by hand, <em>or</em></li>
    <li><strong>Open the <code>.fillable.pdf</code> in Microsoft Edge or Adobe Acrobat</strong>
        and tick the checkboxes as we go.</li>
  </ul>
  <p>Your card ID (have this ready if you call bingo):</p>
  <p style="font-family: monospace; font-size: 1.1em;">{{ card_id }}</p>
  {% if event.starts_at %}<p>Event time: {{ event.starts_at }}</p>{% endif %}
  <p>See you then!</p>
  <hr>
  <p style="color:#888;font-size:0.85em;">Sent by bingo-trivia-system · event: {{ event.id }}</p>
</body>
</html>
