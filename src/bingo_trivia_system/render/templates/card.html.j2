<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{ event.title }} — Card {{ card.id }}</title>
  <style>
    @page { size: Letter; margin: 0.5in; }
    body { font-family: 'DejaVu Sans', sans-serif; color: #111; }
    header { text-align: center; margin-bottom: 0.3in; }
    h1 { font-size: 22pt; margin: 0; }
    .meta { font-size: 9pt; color: #666; }
    .name { margin: 0.15in 0; font-size: 11pt; }
    table.bingo { width: 100%; border-collapse: collapse; table-layout: fixed; }
    table.bingo td {
      border: 1.5pt solid #111;
      width: 20%; height: 1.4in;
      text-align: center; vertical-align: middle;
      font-size: 11pt; padding: 4pt; word-wrap: break-word;
    }
    .free { font-weight: bold; color: #888; font-size: 14pt; }
    footer { margin-top: 0.2in; font-size: 8pt; color: #888; display: flex; justify-content: space-between; }
    .check { float: left; width: 12pt; height: 12pt; border: 1pt solid #111; }
  </style>
</head>
<body>
  <header>
    <h1>{{ event.title }}</h1>
    <div class="meta">Card ID: {{ card.id }}</div>
  </header>
  <div class="name">Name: ____________________________</div>
  <table class="bingo">
    {% for row in rows %}
    <tr>
      {% for cell in row %}
      <td>
        {% if mode == 'fillable' %}<span class="check"></span>{% endif %}
        {% if cell == 'FREE' %}<span class="free">FREE</span>{% else %}{{ cell }}{% endif %}
      </td>
      {% endfor %}
    </tr>
    {% endfor %}
  </table>
  <footer>
    <span>bingo-trivia-system · {{ event.id }}</span>
    <span>mode: {{ mode }}</span>
  </footer>
</body>
</html>
