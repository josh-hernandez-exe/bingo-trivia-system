# Microsoft Graph (delegated device-code auth — leave secret unset)
GRAPH_TENANT_ID=your-tenant-id-here
GRAPH_CLIENT_ID=your-app-registration-client-id-here

# AWS SES
AWS_PROFILE=default
AWS_REGION=us-east-1
SES_FROM_ADDR=trivia@example.com

# Default event id for CLI / web UI when --event isn't passed
EVENT_DEFAULT=example-shapes-and-colors
